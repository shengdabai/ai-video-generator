# Server
PORT=8000
NODE_ENV=development

# JWT
# Generate strong, distinct secrets, e.g.: openssl rand -hex 32
# Must be at least 32 characters. Use DIFFERENT values for access and refresh.
# The placeholders below are intentionally NOT valid secrets — replace them.
JWT_SECRET=__CHANGE_ME__run_openssl_rand_hex_32
JWT_REFRESH_SECRET=__CHANGE_ME__run_openssl_rand_hex_32_distinct
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# CORS
# Comma-separated list of allowed origins. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:8081

# Database
DB_PATH=./data/vidcraft.db
